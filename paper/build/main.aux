\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview. For \emph  {any} SAE latent $f$, with no behavioural task, a per-seed problem instance $(f, \mathcal  {D}_f, \pi )$ is formed from stored contexts where the seed fires and retrieved contexts where it is silent (\S  \ref {sec:problem}). Discovery runs by gradient attribution (counterfactual and ablation objectives, ranked and cut) and by learned-mask optimisation (a gate per upstream latent). The discovered circuit is examined under two distinct criteria: \emph  {interventional control} (P1), validated by intervening on the seed itself, and \emph  {ablation faithfulness} \labelcref  {eq:p2}, the measured cost of the circuit reproducing the seed alone under free execution, spanning every upstream site. Control is concentrated; faithfulness is collective, position-local, and depth-scaled (\S  \ref {sec:drivers-closure}).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{Overview. For \emph {any} SAE latent $f$, with no behavioural task, a per-seed problem instance $(f, \mathcal {D}_f, \pi )$ is formed from stored contexts where the seed fires and retrieved contexts where it is silent (\S \ref {sec:problem}). Discovery runs by gradient attribution (counterfactual and ablation objectives, ranked and cut) and by learned-mask optimisation (a gate per upstream latent). The discovered circuit is examined under two distinct criteria: \emph {interventional control} (P1), validated by intervening on the seed itself, and \emph {ablation faithfulness} \labelcref {eq:p2}, the measured cost of the circuit reproducing the seed alone under free execution, spanning every upstream site. Control is concentrated; faithfulness is collective, position-local, and depth-scaled (\S \ref {sec:drivers-closure})}{figure.1}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
