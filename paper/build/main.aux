\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces How weighted circuit masking works. \textbf  {(a)}~For a target latent $f$, every latent at every upstream SAE site is a candidate node. \textbf  {(b)}~Each candidate gets a gate $m$ (kept or closed) and a scaling coefficient $\alpha $: a kept latent contributes $\alpha $ times its live value, and a closed one is replaced by its ablation value. One set of gates and coefficients is used under three ablation methods at once. \textbf  {(c)}~They are trained so that, under each ablation method, the circuit reproduces $f$'s pre-activation at its anchor positions, with a price on every open gate. \textbf  {(d)}~The resulting weighted circuit, typically $10^{2}$--$10^{3}$ latents, is tested on held-out contexts by faithfulness, necessity, and sufficiency to induce, against random circuits of the same size given the same coefficient fitting.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{How weighted circuit masking works. \textbf {(a)}~For a target latent $f$, every latent at every upstream SAE site is a candidate node. \textbf {(b)}~Each candidate gets a gate $m$ (kept or closed) and a scaling coefficient $\alpha $: a kept latent contributes $\alpha $ times its live value, and a closed one is replaced by its ablation value. One set of gates and coefficients is used under three ablation methods at once. \textbf {(c)}~They are trained so that, under each ablation method, the circuit reproduces $f$'s pre-activation at its anchor positions, with a price on every open gate. \textbf {(d)}~The resulting weighted circuit, typically $10^{2}$--$10^{3}$ latents, is tested on held-out contexts by faithfulness, necessity, and sufficiency to induce, against random circuits of the same size given the same coefficient fitting}{figure.1}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][1][]2}{}{}{}}
