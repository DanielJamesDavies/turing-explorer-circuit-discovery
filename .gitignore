# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Native extension build artifacts
*.so
*.pyd
*.o
src/native/build/

# Virtual environment
.venv/
.env.local
.env.*.local

# Data & outputs
/data/
/outputs/
# Public-model corpora and data-pass artefacts (DAN-37, experiments/069-public-data-pass)
/data_public/
/outputs_public/
# Files staged for deletion by hand (never committed)
/_delete/
profile_trace/
/paper/resources/*
/paper-backups/*

# Paper build: LaTeX intermediates change on every build; keep only the PDF
/paper/build/*
!/paper/build/main.pdf

# Editor / OS / local tool settings
.cursor/
.claude/settings.local.json
Thumbs.db
.DS_Store
desktop.ini

/models
AGENTS.md
/analysis-restyled
/analysis-regenerated
/dev-notes
# experiments/: code, READMEs and small result files are TRACKED (the
# evidence behind the paper). Heavy/regenerable artifacts are not.
/experiments/**/*.pt
/experiments/**/*.safetensors
/experiments/**/*.zip
/experiments/**/*.tgz
/experiments/**/*.pickle
/experiments/**/*.log
/experiments/**/__pycache__/
/experiments/**/transcoders_llama_ct/
/experiments/**/dictionaries_*/
/experiments/**/*.jsonl.gz
/experiments/**/*.flag
/experiments/_archive/
# 049: flattened tables (regenerable from the shard stores) and the two
# per-latent csvs (20-45 MB each); everything else in results*/ is tracked
/experiments/049-circuit-graph/tables*/
/experiments/049-circuit-graph/results*/amplitude_profiles.csv
/experiments/049-circuit-graph/results*/fanout_latents.csv
# 062: run outputs come back from the pod as a tarball; logs are regenerated
/experiments/062-h100-protocol-v1/out*/
/experiments/062-h100-protocol-v1/logs/
# 082 public-model chain: pod outputs (out_<model>, out_turingllm, out_prelim_<model>), the local LIMIT smoke, logs
/experiments/082-public-runs/out_*/
/experiments/082-public-runs/smoke/
/experiments/082-public-runs/logs/
/experiments/082-public-runs/prelim/
# 063: the ~2,400 per-circuit screening reports (84 MB) are regenerable with inspect_circuit.py from the 062 run
# outputs. Track the code, README, validation results, each screen's index.csv, and the reports and member lists of
# the case studies the paper uses. Files (not folders) are ignored, so the exceptions below can re-include them.
/experiments/063-case-studies/lab_queue/
/experiments/063-case-studies/results_lab/subsets/
/experiments/063-case-studies/results*/reports/*
/experiments/063-case-studies/results*/members/*
!/experiments/063-case-studies/results_full_deep/reports/8.attn.29991.md
!/experiments/063-case-studies/results_full_deep/reports/9.resid.7640.md
!/experiments/063-case-studies/results_full_deep/reports/10.resid.34899.md
!/experiments/063-case-studies/results_full_deep/members/8.attn.29991.csv
!/experiments/063-case-studies/results_full_deep/members/9.resid.7640.csv
!/experiments/063-case-studies/results_full_deep/members/10.resid.34899.csv

# 2026-10-25: experiment OUTPUTS are never committed (run data stays on disk / the pod volume / backups). Code,
# READMEs, target lists and small configs are tracked. These rules only affect untracked files.
/experiments/**/out/
/experiments/**/out_*/
/experiments/**/smoke*/
/experiments/**/exact/
/experiments/**/*.pt
/experiments/**/*.npy
/experiments/**/*.npz
/experiments/**/*.parquet
/experiments/**/*.tgz
/experiments/**/*.log
# 080 run data (calibration curves and rows, causal-effect measurements; parked experiment)
/experiments/080-latent-vs-output/calib*/
/experiments/080-latent-vs-output/effect/
# 081 generated task files (~88 MB; regenerate identically with make_tasks.py)
/experiments/081-task-circuits/tasks/

# Root-level scratch from local smokes and transfers (never commit)
/*.log
/*.flag
/*.bak
/*.tgz
/*.zip
# Other papers' official code, cloned at pinned commits for exp 107 (never committed; see 107/README.md)
/third_party/
# Items staged for deletion (review, then delete the folder in File Explorer)
/_to_delete/
# Private documents (repo is public): tutor correspondence and internal reviews
/docs/tutor-update/
/docs/critical-review-*.md
# Local run leftovers: queue gate flags (scripts wait for these on disk), run logs, watcher stamps
/experiments/**/READY
/experiments/**/*_READY
/experiments/**/logs/
/experiments/**/*.out
/experiments/**/*.watchstart
